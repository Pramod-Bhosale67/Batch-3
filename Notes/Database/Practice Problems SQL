Select * from Employees

-- WAQ to showcase the first name and the hiring date of each Emp
SELECT first_name, hire_date FROM Employees

-- WAQ to find the name of emp having salary more than 50000
SELECT first_name, salary FROM Employees WHERE salary > 50000

-- WAQ to find the emp_id and first_name of the emp working in IT dept
SELECT emp_id, first_name FROM Employees WHERE department = 'IT'

-- WAQ to find the emp_id and the first name of the emp working in IT or HR dept
SELECT emp_id, first_name FROM Employees WHERE department = 'IT' or department = 'HR'

-- WAQ to find the emp_id and the first name of the emp working in IT or HR or marketing dept
SELECT emp_id, first_name FROM Employees WHERE department = 'IT' or department = 'HR' or 
												department = 'Marketing'

SELECT emp_id, first_name FROM Employees WHERE department IN ('IT', 'HR', 'Marketing')
SELECT emp_id, first_name FROM Employees WHERE department any ('IT', 'HR', 'Marketing')

-- WAQ to find the name and the hiring date of the emp having sal in between 30,000 to 60,000
SELECT first_name, hire_date FROM Employees WHERE salary >= 30000 and salary <= 60000
SELECT first_name, hire_date FROM Employees WHERE salary BETWEEN 30000 AND 60000

-- WAQ to sort the emp table by salary in increasing order
SELECT * FROM Employees ORDER BY hire_date
SELECT * FROM Employees ORDER BY salary DESC

-- WAQ to print the name of emp starting with letter P
SELECT first_name FROM Employees WHERE first_name like 'P%'

-- WAQ to print the emp ID whose name ends with a
SELECT emp_id FROM Employees WHERE first_name like '%a'

-- WAQ to print the name of the emp having second letter as a
SELECT first_name FROM Employees WHERE first_name like '_a%'

-- WAQ to print the name of the emp having second letter as o, fourth letter as J
SELECT first_name FROM Employees WHERE first_name like '_o_j%'

-- WAQ to print the name of the emp having first letter as P and last letter as a
SELECT first_name FROM Employees WHERE first_name like 'P%a'
